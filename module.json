{
  "id": "zft-raised-hands",
  "title": "ZFT Raised Hands",
  "description": "Persistent raised-hand queue for Foundry VTT with GM queue management and player raise/lower controls.",
  "authors": [
    {
      "name": "Zantor's Realms"
    }
  ],
  "version": "1.4.1",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351",
    "maximum": "13"
  },
  "esmodules": [
    "scripts/zft-raised-hands.mjs"
  ],
  "styles": [
    "styles/zft-raised-hands.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "manifest": "https://github.com/farling42/foundryvtt-socketlib/releases/latest/download/module.json"
      }
    ]
  }
}
